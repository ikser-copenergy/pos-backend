DATABASE_URL="postgresql://postgres:root@localhost:5432/POS?schema=public"
PORT=3000
JWT_SECRET="cambia-esto-en-produccion"

# Orígenes del front permitidos por CORS (coma, mismo valor que el header Origin).
# Omitir o "*" = modo permisivo (reflejar origen).
# Producción ejemplo:
# CORS_ORIGINS=http://ec2-xxxx.compute-1.amazonaws.com:3003,https://tudominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
