{
  "name": "pos-backend",
  "version": "1.0.0",
  "description": "Backend base para POS con Node.js, TypeScript y Prisma ORM.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test": "node -e \"process.exit(0)\"",
    "deploy": "bash -lc 'git pull --rebase && npm ci && npm run test || { echo \"ERROR: Unit tests failed. Aborting deploy.\"; exit 1; } && npx prisma generate && npx prisma migrate deploy && npm run build && (pm2 describe pos-backend >/dev/null || pm2 start dist/index.js --name pos-backend) && pm2 restart pos-backend && pm2 save'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikser-copenergy/pos-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ikser-copenergy/pos-backend/issues"
  },
  "homepage": "https://github.com/ikser-copenergy/pos-backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "prisma": "^7.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
